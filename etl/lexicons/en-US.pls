<?xml version="1.0" encoding="UTF-8"?>
<!-- Sound Along shared English pronunciation lexicon (Polly name: saEnUS).
     Starting entries to verify by ear; bump lexiconRevision in voices.json on every change. -->
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
      alphabet="ipa" xml:lang="en-US">
  <lexeme>
    <grapheme>DeSean</grapheme>
    <alias>Deh Shawn</alias>
  </lexeme>
  <lexeme>
    <grapheme>Scottadino</grapheme>
    <alias>Scotta deeno</alias>
  </lexeme>
</lexicon>
