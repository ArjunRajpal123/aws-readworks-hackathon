<?xml version="1.0" encoding="UTF-8"?>
<!-- Sound Along shared Spanish pronunciation lexicon (Polly name: saEsUS).
     Starting entries to verify by ear; bump lexiconRevision in voices.json on every change. -->
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
      alphabet="ipa" xml:lang="es-US">
  <lexeme>
    <grapheme>EE.</grapheme>
    <alias>Estados</alias>
  </lexeme>
  <lexeme>
    <grapheme>UU.</grapheme>
    <alias>Unidos</alias>
  </lexeme>
  <lexeme>
    <grapheme>Sr.</grapheme>
    <alias>señor</alias>
  </lexeme>
</lexicon>
