# Copy to .env (gitignored) to point the player at the real deployed media
# instead of local frontend/public/sa/. Leave unset for local dev with
# etl/Makefile's run-local or run-api.
#
# Value: the CloudFront distribution's domain from infra/cdk's WebStack
# (MediaCdnDomain output), with the /sa/ prefix the ETL writes under.
VITE_MEDIA_BASE_URL=https://xxxxxxxxxxxxxx.cloudfront.net/sa/
