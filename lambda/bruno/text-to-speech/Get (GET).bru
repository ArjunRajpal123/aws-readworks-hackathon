meta {
  name: Get (GET)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/text-to-speech?id={{ttsId}}
  body: none
  auth: none
}

params:query {
  id: {{ttsId}}
}

docs {
  Fetches a product record by id, with fresh presigned audio/timing URLs.
  Run "Create (POST)" first in this same session (it sets `ttsId`), or put
  any passage id here, e.g. a catalog id written by etl/run_aws.py.
}
