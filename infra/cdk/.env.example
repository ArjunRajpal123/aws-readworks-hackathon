# Copy to a local, UNTRACKED file (infra/cdk/.env) and source it before
# running cdk. The repo is public, so no real values are committed.
#
#   cp .env.example .env
#   # edit .env
#   set -a && source .env && set +a
#   npm ci && npx cdk synth

# Optional overrides (sensible defaults exist in lib/config.ts)
export PROJECT_NAME="rg-readworks-bb"
export ENVIRONMENT="dev"
export AWS_REGION="us-west-2"

# Required: GitHub source for the pipeline.
export GITHUB_OWNER="your-org-or-user"
export GITHUB_REPO="aws-readworks"
export GITHUB_BRANCH="main"

# Required: ARN of an authorized CodeConnections (GitHub) connection.
# Create once in the console: Developer Tools > Settings > Connections.
export GITHUB_CONNECTION_ARN="arn:aws:codeconnections:us-west-2:123456789012:connection/REPLACE-ME"

# AWS credentials come from your standard AWS auth (profile / SSO / AWS_* vars).
# export AWS_PROFILE="readworks-sandbox"
