# Copy to a local, UNTRACKED file (infra/cdk/.env) and source it before
# running cdk. The repo is public, so no real values are committed.
#
#   cp .env.example .env
#   set -a && source .env && set +a
#   npm ci && npx cdk synth

# Optional overrides (sensible defaults exist in lib/config.ts)
export PROJECT_NAME="rg-readworks-bb"
export ENVIRONMENT="dev"
export AWS_REGION="us-west-2"

# REQUIRED once the storage stack exists: the live media bucket name
# (storage stack output MediaBucketName). If it doesn't match, a deploy
# REPLACES the bucket and deletes its data.
export MEDIA_BUCKET_NAME="s3-readworks-bb-dev-media-<account-id>"

# IAM role allowed to run kubectl against the frontend EKS cluster
# (e.g. your SSO / sandbox role). Leave empty to skip.
export EKS_ADMIN_ROLE_ARN="arn:aws:iam::<account-id>:role/<your-role>"

export GITHUB_OWNER="ArjunRajpal123"
export GITHUB_REPO="aws-readworks-hackathon"
export GITHUB_BRANCH="feat/sount-along-api"
export GITHUB_CONNECTION_ARN="arn:aws:codeconnections:us-west-2:639828717145:connection/48"

# AWS credentials come from your standard AWS auth (profile / SSO / AWS_* vars
# or, in this sandbox, the instance role). Nothing else is required right now.
