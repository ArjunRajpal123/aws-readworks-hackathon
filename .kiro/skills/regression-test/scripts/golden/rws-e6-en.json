    "audio/rws-e6-en/tts-1.input.ssml": {
      "content": "<speak><amazon:effect name=\"drc\"><prosody rate=\"95%\"><p><s>I left the office without so much as detention!</s></p><p><s>A lot of the time, I just wrote what my editor, the fifth-grade English teacher, assigned me.</s></p><p><s>I was eight years old and a brand-new reporter.</s></p><p><s>On Thursday, October 17th, a different sound hit the playground of Mars Hill Elementary.</s></p></prosody></amazon:effect></speak>",
      "contentType": "application/ssml+xml",
      "encoding": null
    },
