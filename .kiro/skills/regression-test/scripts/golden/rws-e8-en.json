    "audio/rws-e8-en/tts-1.input.ssml": {
      "content": "<speak><amazon:effect name=\"drc\"><prosody rate=\"95%\"><p><s>His energy was back.</s></p><p><s>Even though it was sunny outside, he felt a black cloud hovering over his head, threatening stormy weather inside his brain and making him angry.</s></p><p><s>The morning of his 6th grade field trip to the Rose Center for Earth and Space at the Museum of Natural History, he fell ill.</s></p><p><s>Surely the museum was closed, and Mr. Connolly had gone home.</s></p></prosody></amazon:effect></speak>",
      "contentType": "application/ssml+xml",
      "encoding": null
    },
