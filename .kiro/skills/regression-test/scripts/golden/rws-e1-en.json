    "audio/rws-e1-en/tts-1.input.ssml": {
      "content": "<speak><amazon:effect name=\"drc\"><prosody rate=\"95%\"><p><s>It was a very peaceful place.</s></p><p><s>The zebras knew to stay away from the lions who preyed on them, and the mice knew to stay hidden under the trees, away from the large birds who swooped down to eat them.</s></p><p><s>The four animals looked over to the hippopotamus, now about a third of the way into the pond, chomping on some very green leaves with a content and happy expression on his face.</s></p></prosody></amazon:effect></speak>",
      "contentType": "application/ssml+xml",
      "encoding": null
    },
