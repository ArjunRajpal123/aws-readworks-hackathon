        "contentTokenized": "<p><span data-w=\"0\">It</span> <span data-w=\"1\">was</span> <span data-w=\"2\">a</span> <span data-w=\"3\">very</span> <span data-w=\"4\">peaceful</span> <span data-w=\"5\">place.</span></p><p><span data-w=\"6\">The</span> <span data-w=\"7\">zebras</span> <span data-w=\"8\">knew</span> <span data-w=\"9\">to</span> <span data-w=\"10\">stay</span> <span data-w=\"11\">away</span> <span data-w=\"12\">from</span> <span data-w=\"13\">the</span> <span data-w=\"14\">lions</span> <span data-w=\"15\">who</span> <span data-w=\"16\">preyed</span> <span data-w=\"17\">on</span> <span data-w=\"18\">them,</span> <span data-w=\"19\">and</span> <span data-w=\"20\">the</span> <span data-w=\"21\">mice</span> <span data-w=\"22\">knew</span> <span data-w=\"23\">to</span> <span data-w=\"24\">stay</span> <span data-w=\"25\">hidden</span> <span data-w=\"26\">under</span> <span data-w=\"27\">the</span> <span data-w=\"28\">trees,</span> <span data-w=\"29\">away</span> <span data-w=\"30\">from</span> <span data-w=\"31\">the</span> <span data-w=\"32\">large</span> <span data-w=\"33\">birds</span> <span data-w=\"34\">who</span> <span data-w=\"35\">swooped</span> <span data-w=\"36\">down</span> <span data-w=\"37\">to</span> <span data-w=\"38\">eat</span> <span data-w=\"39\">them.</span></p><p><span data-w=\"40\">The</span> <span data-w=\"41\">four</span> <span data-w=\"42\">animals</span> <span data-w=\"43\">looked</span> <span data-w=\"44\">over</span> <span data-w=\"45\">to</span> <span data-w=\"46\">the</span> <span data-w=\"47\">hippopotamus,</span> <span data-w=\"48\">now</span> <span data-w=\"49\">about</span> <span data-w=\"50\">a</span> <span data-w=\"51\">third</span> <span data-w=\"52\">of</span> <span data-w=\"53\">the</span> <span data-w=\"54\">way</span> <span data-w=\"55\">into</span> <span data-w=\"56\">the</span> <span data-w=\"57\">pond,</span> <span data-w=\"58\">chomping</span> <span data-w=\"59\">on</span> <span data-w=\"60\">some</span> <span da