    "audio/rws-e5-es/tts-1.input.ssml": {
      "content": "<speak><amazon:effect name=\"drc\"><prosody rate=\"95%\"><p><s>Las placas tectónicas descansan sobre una capa de magma caliente.</s></p><p><s>Los científicos han descubierto que esta placa crece en su lado oriental, pero se destruye cuando se desliza bajo las placas de su lado occidental.</s></p><p><s>Este supercontinente se formó hace unos 300 millones de años y era básicamente un único trozo gigante de tierra.</s></p></prosody></amazon:effect></speak>",
      "contentType": "application/ssml+xml",
      "encoding": null
    },
